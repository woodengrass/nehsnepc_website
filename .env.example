# Keystatic GitHub-mode configuration (official GitHub App flow only).
#
# Copy to a REAL env file that is NEVER committed (e.g. `.env.local`) and fill
# in values from the GitHub App + Vercel project settings:
#   cp .env.example .env.local
#
# All values below are PLACEHOLDERS — never real secrets. Minimum lengths are
# enforced at runtime before the Keystatic handler is constructed:
#   - KEYSTATIC_GITHUB_CLIENT_ID:     at least 8 chars
#   - KEYSTATIC_GITHUB_CLIENT_SECRET: at least 20 chars
#   - KEYSTATIC_SECRET:               at least 32 chars (31 chars fails closed)
#   - NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG: at least 8 chars, non-empty
#     (public GitHub App slug from the App's URL/settings page — required by
#     the official @keystatic/next route handler + UI bundle; appears in URLs,
#     so it is public by design, never a secret)
# Missing/short secrets -> redacted 503; the server NEVER falls back to local
# writes and NEVER logs secret values (names only).

# GitHub App client id (public identifier, min 8 chars).
KEYSTATIC_GITHUB_CLIENT_ID=your-github-app-client-id

# GitHub App client secret (server-only, min 20 chars).
KEYSTATIC_GITHUB_CLIENT_SECRET=your-github-app-client-secret-here

# Keystatic session secret (server-only, min 32 chars — generate 32+ random bytes).
KEYSTATIC_SECRET=replace-with-a-random-string-at-least-32-chars-long

# GitHub App slug (PUBLIC value, min 8 chars, never a secret).
# Find it on the GitHub App's settings page or in its URL
# (https://github.com/settings/apps/<slug>). Required by the official
# @keystatic/next route handler + UI bundle for GitHub-mode login.
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=your-github-app-slug

# Pinned content repository (owner/name). Must stay exactly this value.
KEYSTATIC_GITHUB_REPO=woodengrass/nehsnepc_website

# Canonical production HTTPS origin, no trailing slash (server-only).
# www is canonical; the apex is accepted as an alias by the API gate (a single
# leading www. is ignored on both sides before comparing — anything else 403s).
# Register BOTH callback URLs in the GitHub App settings (apex + www):
#   {apex}/api/keystatic/github/oauth/callback
#   {www}/api/keystatic/github/oauth/callback
# API requests from any other origin get a redacted 403; safe wrong-host UI
# GETs redirect (308) to this literal origin — the request Host is never used.
KEYSTATIC_PRODUCTION_ORIGIN=https://your-production-domain.example

# Dev-only local-mode flag. Set to `1` ONLY for loopback `admin:dev` editing
# (`NODE_ENV=development` is also required). NEVER set in production/preview:
# ordinary dev/production/preview always use GitHub mode.
NEXT_PUBLIC_KEYSTATIC_LOCAL_MODE=

# Web3Forms access key (PUBLIC routing identifier, NOT a secret).
# Build-time only. Leave blank until provider readiness passes (task 8).
# Never commit a real key.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
